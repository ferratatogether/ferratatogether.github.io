  <wpt lon="7.615416" lat="46.397647">
    <ele>2332</ele>
    <name>Restaurant Wildstrubel</name>
    <desc>Günstige Unterkunft im Gemmigebiet / Alle Gäste des Hotel fahren bei An- und Abreise mit der Bahn zum 1/2 tax SBB Preis / Moderne sanitäre Einrichtungen / Alle Zimmer mit Blick auf die Walliser und Berner Alpen / Ideal für Gruppen, Vereine, Schulen und Seminare /</desc>
    <src>outdooractive.21430.1313233</src>
    <link href="http://www.gemmi.ch/hotel/"/>
    <type>Mountain Restaurant</type>
  </wpt>
